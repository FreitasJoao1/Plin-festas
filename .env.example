# ============================================================================
# Plin Festas — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha os valores reais.
# O site funciona em "modo demo" com este arquivo vazio/incompleto — cada
# integração cai automaticamente para um fallback (ver src/lib/*/config).
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# TODO: crie um projeto em https://supabase.com, depois vá em
# Project Settings > API para pegar esses 3 valores.
# Sem essas 2 primeiras, o site inteiro roda em modo demo (dados mock,
# sem login, sem persistir pedidos).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role) — NUNCA exponha no client, é usada só em
# código server-side de admin. Fica na mesma tela do Supabase acima, em
# "service_role secret".
SUPABASE_SERVICE_ROLE_KEY=

# --- Melhor Envio (frete Correios) --------------------------------------
# TODO: crie uma conta em https://melhorenvio.com.br, gere um token em
# Configurações > Tokens (comece pelo ambiente sandbox para testar).
# Sem isso, o frete via Correios cai automaticamente para "por conta do
# cliente, combinado por WhatsApp" — as outras 3 opções de frete
# (retirada, entrega própria, Uber Flash) funcionam sempre, mesmo sem isto.
MELHOR_ENVIO_TOKEN=
# CEP de origem (onde a loja fica) — sem espaço, só números.
MELHOR_ENVIO_CEP_ORIGEM=

# --- WhatsApp -------------------------------------------------------------
# Número da loja em formato internacional, só dígitos (DDI+DDD+número).
# Exemplo Salvador/BA: 5571999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Site -------------------------------------------------------------------
# URL pública do site em produção (sem barra no final). Usada para montar
# o link de confirmação de e-mail do Supabase Auth. Em produção (Vercel,
# por exemplo) normalmente é a URL do seu domínio, ex: https://plinfestas.com.br
NEXT_PUBLIC_SITE_URL=

# --- InfinitePay (pagamento online opcional — Pix/cartão) -----------------
# TODO: crie uma conta em https://www.infinitepay.io, pegue sua InfiniteTag
# (o "handle" que aparece no canto superior esquerdo do app, sem o $).
# Sem isso, o botão "Pagar agora" simplesmente não aparece no checkout —
# o WhatsApp continua sendo a forma padrão de fechar pedido, sempre.
INFINITEPAY_HANDLE=
# Doc: https://ajuda.infinitepay.io/pt-BR/articles/10766888

# --- Resend (e-mail de notificação de recusa de agendamento) ---------------
# TODO: crie uma conta em https://resend.com, verifique seu domínio de
# envio e gere uma API key em API Keys.
# Sem isso, a recusa de pedido continua funcionando normalmente (salva no
# banco), só não dispara e-mail automático ao cliente — ele ainda é
# avisado pelo status do pedido em /conta e pelo link de WhatsApp.
RESEND_API_KEY=
# Precisa ser um remetente do domínio verificado no Resend, ex:
# "Plin Designs <pedidos@plindesigns.com.br>"
RESEND_FROM_EMAIL=
