# ============================================================================
# Plin Festas — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha os valores reais.
# O site funciona em "modo demo" com este arquivo vazio/incompleto — cada
# integração cai automaticamente para um fallback (ver src/lib/*/config).
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# TODO: crie um projeto em https://supabase.com, depois vá em
# Project Settings > API para pegar esses 3 valores.
# Sem essas 2 primeiras, o site inteiro roda em modo demo (dados mock,
# sem login, sem persistir pedidos).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role) — NUNCA exponha no client, é usada só em
# código server-side (ex: webhook do Mercado Pago). Fica na mesma tela do
# Supabase acima, em "service_role secret".
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago -------------------------------------------------------
# TODO: pegue o Access Token em
# https://www.mercadopago.com.br/developers/panel/app > Credenciais.
# Use as credenciais de TESTE enquanto desenvolve, e troque para produção
# só quando for lançar de verdade.
# Sem isso, o checkout funciona em modo demo (mostra tela de sucesso
# simulada, sem cobrar nada de verdade).
MERCADOPAGO_ACCESS_TOKEN=

# --- Melhor Envio (frete Correios) --------------------------------------
# TODO: crie uma conta em https://melhorenvio.com.br, gere um token em
# Configurações > Tokens (comece pelo ambiente sandbox para testar).
# Sem isso, o frete via Correios cai automaticamente para "por conta do
# cliente, combinado por WhatsApp" — as outras 3 opções de frete
# (retirada, entrega própria, Uber Flash) funcionam sempre, mesmo sem isto.
MELHOR_ENVIO_TOKEN=
# CEP de origem (onde a loja fica) — sem espaço, só números.
MELHOR_ENVIO_CEP_ORIGEM=

# --- WhatsApp -------------------------------------------------------------
# Número da loja em formato internacional, só dígitos (DDI+DDD+número).
# Exemplo Salvador/BA: 5571999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Site -------------------------------------------------------------------
# URL pública do site em produção (sem barra no final). É usada para montar
# as back_urls do Mercado Pago e a notification_url do webhook — o Mercado
# Pago precisa alcançar essa URL pela internet, então NÃO funciona com
# localhost. Em produção (Vercel, por exemplo) normalmente é a URL do seu
# domínio, ex: https://plinfestas.com.br
NEXT_PUBLIC_SITE_URL=
